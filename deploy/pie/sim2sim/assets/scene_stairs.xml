<mujoco model="pie stairs up and down">
  <!--
    Route direction: +X

      y=0.0: ground -> 6 stairs up -> flat landing -> 6 stairs down -> ground
      y=2.4: parallel level-9 route with the same layout

    Reference route dimensions:
      course width = 2.00 m
      stair tread  = 0.30 m
      stair rise   = 0.12 m

    The level-9 route uses a representative 0.24 m rise from PIE's
    0.228-0.250 m training range. Its course width and tread stay unchanged.
  -->
  <statistic center="3.40 0 0.36" extent="8.0" />

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
    <rgba haze="0.15 0.25 0.35 1" />
    <global azimuth="-130" elevation="-20" />
  </visual>

  <asset>
    <texture
      type="skybox"
      builtin="gradient"
      rgb1="0.3 0.5 0.7"
      rgb2="0 0 0"
      width="512"
      height="3072"
    />
    <texture
      type="2d"
      name="groundplane"
      builtin="checker"
      mark="edge"
      rgb1="0.20 0.30 0.40"
      rgb2="0.10 0.20 0.30"
      markrgb="0.8 0.8 0.8"
      width="300"
      height="300"
    />
    <material
      name="groundplane"
      texture="groundplane"
      texuniform="true"
      texrepeat="5 5"
      reflectance="0.2"
    />
    <material name="stairs" rgba="0.58 0.62 0.68 1" />
    <material name="landing" rgba="0.34 0.40 0.48 1" />
    <material name="stairs_level9" rgba="0.82 0.38 0.20 1" />
    <material name="landing_level9" rgba="0.52 0.20 0.12 1" />
  </asset>

  <worldbody>
    <light pos="3.4 0 8" dir="0 0 -1" directional="true" />
    <geom
      name="floor"
      type="plane"
      size="0 0 0.05"
      material="groundplane"
      contype="1"
      conaffinity="1"
      condim="3"
      friction="0.6 0.005 0.0001"
    />

    <!-- Up staircase: x=[1.20, 3.00], surface z=0.12...0.72. -->
    <geom name="stairs_up_step_01" type="box" pos="1.35 0 0.06" size="0.15 1.00 0.06" material="stairs" />
    <geom name="stairs_up_step_02" type="box" pos="1.65 0 0.18" size="0.15 1.00 0.06" material="stairs" />
    <geom name="stairs_up_step_03" type="box" pos="1.95 0 0.30" size="0.15 1.00 0.06" material="stairs" />
    <geom name="stairs_up_step_04" type="box" pos="2.25 0 0.42" size="0.15 1.00 0.06" material="stairs" />
    <geom name="stairs_up_step_05" type="box" pos="2.55 0 0.54" size="0.15 1.00 0.06" material="stairs" />
    <geom name="stairs_up_step_06" type="box" pos="2.85 0 0.66" size="0.15 1.00 0.06" material="stairs" />

    <!-- Landing: x=[3.00, 5.00], surface z=0.72. -->
    <geom name="stairs_landing" type="box" pos="4.00 0 0.36" size="1.00 1.00 0.36" material="landing" />

    <!--
      Down staircase: five raised treads, followed by the sixth and final
      0.12 m descent onto the ground plane.
    -->
    <geom name="stairs_down_step_01" type="box" pos="5.15 0 0.54" size="0.15 1.00 0.06" material="stairs" />
    <geom name="stairs_down_step_02" type="box" pos="5.45 0 0.42" size="0.15 1.00 0.06" material="stairs" />
    <geom name="stairs_down_step_03" type="box" pos="5.75 0 0.30" size="0.15 1.00 0.06" material="stairs" />
    <geom name="stairs_down_step_04" type="box" pos="6.05 0 0.18" size="0.15 1.00 0.06" material="stairs" />
    <geom name="stairs_down_step_05" type="box" pos="6.35 0 0.06" size="0.15 1.00 0.06" material="stairs" />

    <!--
      Parallel level-9 route: y=[1.40, 3.40], 0.24 m rise, 0.30 m tread.
      Six ascending steps reach the 1.44 m landing.
    -->
    <geom name="stairs_level9_up_step_01" type="box" pos="1.35 2.40 0.12" size="0.15 1.00 0.12" material="stairs_level9" />
    <geom name="stairs_level9_up_step_02" type="box" pos="1.65 2.40 0.24" size="0.15 1.00 0.24" material="stairs_level9" />
    <geom name="stairs_level9_up_step_03" type="box" pos="1.95 2.40 0.36" size="0.15 1.00 0.36" material="stairs_level9" />
    <geom name="stairs_level9_up_step_04" type="box" pos="2.25 2.40 0.48" size="0.15 1.00 0.48" material="stairs_level9" />
    <geom name="stairs_level9_up_step_05" type="box" pos="2.55 2.40 0.60" size="0.15 1.00 0.60" material="stairs_level9" />
    <geom name="stairs_level9_up_step_06" type="box" pos="2.85 2.40 0.72" size="0.15 1.00 0.72" material="stairs_level9" />

    <geom name="stairs_level9_landing" type="box" pos="4.00 2.40 0.72" size="1.00 1.00 0.72" material="landing_level9" />

    <!-- Five raised treads, followed by the final 0.24 m drop to ground. -->
    <geom name="stairs_level9_down_step_01" type="box" pos="5.15 2.40 0.60" size="0.15 1.00 0.60" material="stairs_level9" />
    <geom name="stairs_level9_down_step_02" type="box" pos="5.45 2.40 0.48" size="0.15 1.00 0.48" material="stairs_level9" />
    <geom name="stairs_level9_down_step_03" type="box" pos="5.75 2.40 0.36" size="0.15 1.00 0.36" material="stairs_level9" />
    <geom name="stairs_level9_down_step_04" type="box" pos="6.05 2.40 0.24" size="0.15 1.00 0.24" material="stairs_level9" />
    <geom name="stairs_level9_down_step_05" type="box" pos="6.35 2.40 0.12" size="0.15 1.00 0.12" material="stairs_level9" />
  </worldbody>
</mujoco>
